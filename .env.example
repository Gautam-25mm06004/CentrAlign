# Copy to .env and fill in. Never commit .env.
# Free-tier key from https://aistudio.google.com/apikey  (no billing linked)
GEMINI_API_KEY=
# Model with enough free quota for agent runs. Tested live: gemini-3.5-flash-lite (gemini-3.8-flash free tier = 20 requests/day)
# List what your key can use with 0_list_models.bat (or python scripts/list_models.py)
GEMINI_MODEL=gemini-3.5-flash-lite
# Requests per day for that model on your free tier (AI Studio > Dashboard > Rate Limit). gemini-3.5-flash-lite free tier: 500.
# If left empty, daily protection is OFF (a warning is shown).
GEMINI_RPD=500
# Share of that daily allowance this project may use (0.9 = keep 10% headroom)
GEMINI_EVAL_SHARE=0.9
# Requests per minute; calls are paced to stay under it (gemini-3.5-flash-lite free tier allows 15; 12 keeps a margin)
GEMINI_RPM=12
# Thinking control: budget:N (2.5 models), level:low (3.x models) or off
GEMINI_THINKING=level:low
GEMINI_MAX_OUTPUT_TOKENS=2048
# Hard caps
MAX_MODEL_CALLS_PER_RUN=90
MAX_TOOL_STEPS=160
CONTEXT_TOKEN_CEILING=10000
